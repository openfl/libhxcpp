<xml>

<set name="MBEDTLS_DIR" value="${HXCPP}/project/thirdparty/mbedtls-4.1.1" />

<files id="mbedtls" tags="" >
	<depend name="${this_dir}/mbedtls-files.xml" dateOnly="true" />
	<cache value="true" asLibrary="true" />

	<include name="${this_dir}/mbedtls-flags.xml" />

	<!-- The headers private to the library: mbedTLS's own, for TLS and X.509,
	     and those of TF-PSA-Crypto, where mbedTLS 4 keeps its cryptography. -->
	<compilerflag value="-I${MBEDTLS_DIR}/library" />
	<compilerflag value="-I${MBEDTLS_DIR}/tf-psa-crypto/core" />
	<compilerflag value="-I${MBEDTLS_DIR}/tf-psa-crypto/dispatch" />
	<compilerflag value="-I${MBEDTLS_DIR}/tf-psa-crypto/drivers/builtin/src" />
	<compilerflag value="-I${MBEDTLS_DIR}/tf-psa-crypto/extras" />
	<compilerflag value="-I${MBEDTLS_DIR}/tf-psa-crypto/platform" />
	<compilerflag value="-I${MBEDTLS_DIR}/tf-psa-crypto/utilities" />

	<compilerflag value="-std=c99" unless="isMsvc" />

	<!-- mbedTLS's symbols stay inside the binary that links them. hxcpp links
	     Linux executables with -rdynamic, which exports every symbol of
	     default visibility, and a shared library loaded later that carries its
	     own mbedTLS without hiding it would have its calls bound to this copy
	     -- another version, with other structures -- and crash. hxcpp's own
	     toolchains for Linux, macOS, Android, iOS and Emscripten already
	     compile everything hidden; this keeps mbedTLS hidden under one that
	     does not. Hidden symbols still link within the executable or library
	     that holds them: hxcpp's SSL, a native extension, a static Lime's
	     curl. Windows exports nothing it is not told to. -->
	<compilerflag value="-fvisibility=hidden" unless="windows" />

